root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,md,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,nu,ion,ps1}]
indent_size = 2
